{
	"schemaVersion": 1,
	"id": "toadlib",
	"version": "${version}",
	"name": "ToadLib",
	"description": "Library for Mr.Toad mods. Contains utilities, abstractions, and custom config. MtJava part of toadlib - custom lib for java",
	"authors": [
		"Mr.Toad"
	],
	"contact": {
		"homepage": "https://github.com/ITsMrToad/ToadLib-mod",
		"sources": "https://github.com/ITsMrToad/ToadLib-mod",
		"issues": "https://github.com/ITsMrToad/ToadLib-mod/issues"
	},
	"license": "LGPL V3",
	"icon": "assets/toadlib/logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mr_toad.lib.core.ToadLib"
		],
		"client": [
			"com.mr_toad.lib.client.ToadLibClient"
		],
		"modmenu": [
          "com.mr_toad.lib.client.ToadLibModMenu"
		]
	},
	"accessWidener": "toadlib.accesswidener",
	"mixins": [
		"toadlib.mixins.json",
		{
			"config": "toadlib_client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~26.1",
		"java": ">=25"
	},
	"custom": {
		"modmenu": {
			"badges": [
				"library"
			],
			"update_checker": true
		}
	}
}